# Existing Supabase / analytics variables may also be required by the site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Server-only key used to store purchases, record Premium launch interest,
# and read protected PDF file mappings.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 private PDF storage. Create an R2 S3 API token with Object Read
# access. storage_path must use: bucket-name/path/to/file.pdf
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional override for jurisdiction-specific or custom S3 endpoints.
CLOUDFLARE_R2_ENDPOINT=

# PayPal REST + JavaScript SDK
# Use "sandbox" while testing and switch to "live" only with live credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Generate with: openssl rand -base64 48
# Keep this stable after launch; changing it invalidates active download links.
PAYPAL_DOWNLOAD_SECRET=

# Waffo Pancake — server only. Use a TEST API key for this integration.
# The API key itself determines merchant request environment.
WAFFO_MERCHANT_ID=MER_43OKW9eWvpvqc1s4Y8txgV
WAFFO_STORE_ID=STO_7ZGXX1WgWMBtNFT51lNdkn
WAFFO_ENVIRONMENT=test
WAFFO_PRIVATE_KEY=
# Alternative: base64 of the entire PEM (do not set both key variables).
WAFFO_PRIVATE_KEY_BASE64=
WAFFO_SITE_URL=http://localhost:3000
# Filled by npm run waffo:setup, or copy existing TEST subscription product IDs.
WAFFO_PRODUCT_MONTHLY=
WAFFO_PRODUCT_QUARTERLY=
WAFFO_PRODUCT_ANNUAL=
# Reused when updating webhook registration with waffo:setup.
WAFFO_WEBHOOK_ID=
