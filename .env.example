# Existing Supabase / analytics variables may also be required by the site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used to store purchases and read protected PDF file mappings.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 private PDF storage. Create an R2 S3 API token with Object Read
# access. storage_path must use: bucket-name/path/to/file.pdf
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional override for jurisdiction-specific or custom S3 endpoints.
CLOUDFLARE_R2_ENDPOINT=

# PayPal REST + JavaScript SDK
# Use "sandbox" while testing and switch to "live" only with live credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Generate with: openssl rand -base64 48
# Keep this stable after launch; changing it invalidates active download links.
PAYPAL_DOWNLOAD_SECRET=
